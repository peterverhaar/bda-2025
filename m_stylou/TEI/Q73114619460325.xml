    <text>
        <front>
            <div type="summary">
                <p>
                    Edward Upward writes to Barbara Hepworth in order to inform her that a publisher named Arthaud is interested in a French translation of the book Journey to the Border, and asks her if she would be interested in that.
                </p>
            </div>
        </front>
        <body>
            <div type="letter">
                <opener>
                    <dateline>
                        <placeName>
                            <address><addressLine>154 Turney Pd</addressLine>
                                <addressLine>Dulwich S.E.21</addressLine>
                            </address>
                            
                        </placeName>
                        <date when="1946-03-25">
                            25th March 1946
                        </date>
                    </dateline>
                    <salute>
                        Dear <persName key="Q234109">Miss Hepworth</persName>,
                    </salute>
                </opener>
                <p>
                    <title>Journey to the Border</title> <lb/>
                    I understand that <lb/>
                    inquiries have been made to the <orgName key="Q1623362">Hogarth Press</orgName> <lb/>
                    by <persName key="Q41706014">M. Perrin</persName> on behalf of the publisher <orgName key="Q2864902">Arthaud</orgName> <lb/>
                    of <placeName>Grenoble</placeName> about issuing a French translation <lb/>
                    of <title>Journey to the Border</title>. I shall be glad if <lb/>
                    you will let me know whether there is any <lb/>
                    possibility of negotiating an agreement with <lb/>
                    this firm. <lb/>
                </p>
                <closer>
                    <salute>
                        Yours sincerely,
                    </salute>
                    <signed><persName key="Q731146">Edward Upward</persName>.</signed>
                </closer>
            </div>
        </body>
    </text>
